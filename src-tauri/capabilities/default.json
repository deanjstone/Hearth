    "allow-agent-cancel",
    "allow-agent-backend-get",
    "allow-agent-backend-set",
    "allow-agent-models-get",
    "allow-agent-model-set",
    "allow-agent-modes-get",
    "allow-agent-mode-set",
    "allow-agent-config-get",
    "allow-agent-config-set",
    "allow-agent-usage-get",
    "allow-agent-prompt-caps-get",
    "allow-agent-commands-get",
    "allow-agent-runtime-status",
    "allow-agent-runtime-recheck",
